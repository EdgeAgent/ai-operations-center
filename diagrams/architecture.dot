digraph ai_ops_center {
  graph [rankdir=LR, bgcolor="#0b1117", pad="0.32", nodesep="0.35", ranksep="0.62", splines=ortho, fontname="Arial", fontsize=19, fontcolor="#f4f6f8", label="AI OPERATIONS CENTER  ·  AI AGENTS + N8N OPERATIONS", labelloc=t, labeljust=l];
  node [shape=box, style="rounded,filled", fillcolor="#121d29", color="#ff6b35", penwidth=1.6, fontname="Arial", fontsize=11, fontcolor="#f4f6f8", margin="0.17,0.13", width=1.7, height=0.62];
  edge [color="#ff8a3d", penwidth=1.5, arrowsize=0.72];
  subgraph cluster_sources { label="SIGNAL SOURCES"; style="rounded,filled"; color="#334155"; fillcolor="#101820"; fontname="Arial"; fontsize=10; fontcolor="#18b8d4";
    agents [label="AI agents", color="#18b8d4"];
    n8n [label="n8n workflows", color="#18b8d4"];
    apis [label="APIs & services", color="#18b8d4"];
    activity [label="User activity", color="#18b8d4"];
    {rank=same; agents; n8n; apis; activity;}
  }
  intake [label="Webhook /\nconnector intake"];
  bus [label="Optional event bus\nKafka / NATS", style="rounded,dashed,filled", color="#718096", fillcolor="#101820", fontcolor="#cbd5e1"];
  collect [label="Metrics · logs\n· events"];
  subgraph cluster_center { label="AI OPERATIONS CENTER"; style="rounded,filled"; color="#334155"; fillcolor="#101820"; fontname="Arial"; fontsize=10; fontcolor="#18b8d4";
    modules [label="Telemetry storage\n+ analytics engine\n\nFleet Health · Cost Intelligence\nIncident Center · Governance\nBusiness Metrics · Agent Registry"];
  }
  subgraph cluster_outputs { label="OPERATOR EXPERIENCE"; style="rounded,filled"; color="#334155"; fillcolor="#101820"; fontname="Arial"; fontsize=10; fontcolor="#18b8d4";
    ui [label="Dashboard\nNext.js candidate", color="#18b8d4"];
    grafana [label="Grafana option\n(internal / early view)", style="rounded,dashed,filled", color="#718096", fillcolor="#101820", fontcolor="#cbd5e1"];
    alerts [label="Alerts &\nnotifications", color="#18b8d4"];
    {rank=same; ui; grafana; alerts;}
  }
  agents -> intake;
  n8n -> intake;
  apis -> intake;
  activity -> intake;
  intake -> bus;
  intake -> collect;
  bus -> collect;
  collect -> modules;
  modules -> ui;
  modules -> grafana [style=dashed, color="#718096"];
  modules -> alerts;
}
